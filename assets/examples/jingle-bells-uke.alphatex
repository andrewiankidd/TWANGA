\title "Jingle Bells"
\subtitle "Pierpont, 1857 · standard ukulele (GCEA, reentrant)"
\copyright "Public-domain melody (James Lord Pierpont, 1857). Arrangement under MIT or Apache-2.0."
\tempo 130
\tuning A4 E4 C4 G4
.
// Phrase 1: "Jin-gle bells, jin-gle bells"  E E E | E E E
:4 0.2 0.2 0.2 r | 0.2 0.2 0.2 r |
// Phrase 2: "Jin-gle all the way"  E G C D E
:4 0.2 3.2 0.3 2.3 | 0.2 r r r |
// Phrase 3: "Oh what fun it is to ride"  F F F F F E E E
:8 1.2 1.2 1.2 1.2 1.2 0.2 0.2 0.2 |
// Phrase 4: "In a one-horse o-pen sleigh"  E D D E D G
:4 0.2 2.3 2.3 0.2 | 2.3 3.2 r r |
