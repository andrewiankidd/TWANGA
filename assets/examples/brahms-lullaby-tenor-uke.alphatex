\title "Brahms's Lullaby"
\subtitle "Brahms 'Wiegenlied' Op. 49 No. 4, 1868 · tenor ukulele (low-G GCEA)"
\copyright "Public-domain melody (Johannes Brahms, 1868). Arrangement under MIT or Apache-2.0."
\tempo 80
\tuning A4 E4 C4 G3
.
// Phrase 1: "Lull-a-by and good-night"  G G B G G B
:4 3.2 3.2 2.1 r | 3.2 3.2 2.1 r |
// Phrase 2: "With ro-ses be-dight"  G D B A G F E D
:8 3.2 2.3 2.1 0.1 3.2 1.2 0.2 2.3 |
// Phrase 3: "Lay thee down now and rest"  A A C C E D C
:4 0.1 0.1 1.2 1.2 | 0.2 2.3 0.3 r |
// Phrase 4: "May thy slum-ber be blessed"  A A C C E D C
:4 0.1 0.1 1.2 1.2 | 0.2 2.3 0.3 r |
