\title "Old MacDonald Had a Farm"
\subtitle "Traditional nursery rhyme · standard ukulele (GCEA, reentrant)"
\copyright "Traditional public-domain melody (lyrics published 1917; trad melody older). Arrangement under MIT or Apache-2.0."
\tempo 110
\tuning A4 E4 C4 G4
.
// Phrase 1: "Old Mac-Don-ald had a farm"  G G G D E E D
:4 3.2 3.2 3.2 2.3 | 0.2 0.2 2.3 r |
// Phrase 2: "Ee-ai-ee-ai-oh"  B B A A G
:4 2.1 2.1 0.1 0.1 | 3.2 r r r |
// Phrase 3: (repeat phrase 1)
:4 3.2 3.2 3.2 2.3 | 0.2 0.2 2.3 r |
// Phrase 4: (repeat phrase 2)
:4 2.1 2.1 0.1 0.1 | 3.2 r r r |
