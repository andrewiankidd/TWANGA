\title "Silent Night"
\subtitle "Gruber / Mohr, 1818 · standard ukulele (GCEA, reentrant)"
\copyright "Public-domain melody (Franz Xaver Gruber, 1818; lyrics Joseph Mohr). Arrangement under MIT or Apache-2.0."
\tempo 70
\tuning A4 E4 C4 G4
.
// Phrase 1: "Si-lent night"  G A G E
:4 3.2 0.1 3.2 0.2 | r r r r |
// Phrase 2: "Ho-ly night"  G A G E
:4 3.2 0.1 3.2 0.2 | r r r r |
// Phrase 3: "All is calm, all is bright"  D D B | C C G
:4 2.3 2.3 2.1 r | 1.2 1.2 3.2 r |
// Phrase 4: "Round yon vir-gin moth-er and child"  A A C B A G
:4 0.1 0.1 1.2 2.1 | 0.1 3.2 r r |
// Phrase 5: "Ho-ly in-fant so ten-der and mild"  A A C B A G
:4 0.1 0.1 1.2 2.1 | 0.1 3.2 r r |
// Phrase 6: "Sleep in heav-en-ly peace"  D F D B G E C
:4 2.3 1.2 2.3 2.1 | 3.2 0.2 0.3 r |
