\title "Danny Boy"
\subtitle "Weatherly 1913 + 'Londonderry Air' trad · tenor ukulele (low-G GCEA)"
\copyright "Public-domain melody (lyrics Frederic Weatherly 1913; tune 'Londonderry Air' first printed 1855). Arrangement under MIT or Apache-2.0."
\tempo 70
\tuning A4 E4 C4 G3
.
// Phrase 1: "Oh Dan-ny boy"  G C E G
:4 0.4 0.3 0.2 3.2 | r r r r |
// Phrase 2: "The pipes, the pipes are call-ing"  A G E C D E
:4 0.1 3.2 0.2 0.3 | 2.3 0.2 r r |
// Phrase 3: "From glen to glen"  D E G A
:4 2.3 0.2 3.2 0.1 | r r r r |
// Phrase 4: "And down the moun-tain side"  G F E D C
:4 3.2 1.2 0.2 2.3 | 0.3 r r r |
// Phrase 5: rising — "The sum-mer's gone"  C E G C
:4 0.3 0.2 3.2 3.1 | r r r r |
// Phrase 6: resolve — "and all the flow-ers are dy-ing"  C B A G E C
:4 3.1 2.1 0.1 3.2 | 0.2 0.3 r r |
