\title "Amazing Grace"
\subtitle "Traditional hymn · drop-D guitar (DADGBE) — leans on the low D"
\copyright "Traditional public-domain melody ('New Britain', Walker 1835; lyrics Newton 1779). Arrangement under MIT or Apache-2.0."
\tempo 70
\tuning E4 B3 G3 D3 A2 D2
.
// Phrase 1: "Amazing grace"  D — G — B (rising)
:4 0.4 r 0.3 r | 0.2 r r r |
// Phrase 2: "How sweet the sound"  B — A — G — A — B
:4 0.2 2.3 0.3 2.3 | 0.2 r r r |
// Phrase 3: "That saved a wretch like me"  G — E — D — low D
:4 0.3 2.4 0.4 r | 0.6 r r r |
// Phrase 4: "I once was lost"   D — D — G — B
:4 0.4 0.4 0.3 0.2 | 0.2 r r r |
// Phrase 5: "But now am found"  B — A — G — A — B
:4 0.2 2.3 0.3 2.3 | 0.2 r r r |
// Phrase 6: "Was blind but now I see"  G — D — low D — D
:4 0.3 0.4 0.6 0.4 | 0.4 r r r |
