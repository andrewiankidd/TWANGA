\title "Pachelbel's Canon (excerpt)"
\subtitle "Pachelbel ~1680 · drop-D guitar (DADGBE) — bass line on low D"
\copyright "Public-domain melody (Johann Pachelbel, Canon in D major, ~1680). Arrangement under MIT or Apache-2.0."
\tempo 70
\tuning E4 B3 G3 D3 A2 D2
.
// Canon's iconic 8-bar descending bass: D A B F# G D G A
:4 0.6 0.5 2.5 4.4 | 0.3 0.6 0.3 0.5 |
// Repeat — same bass, this time with melody hint on top
:4 0.6 0.5 2.5 4.4 | 0.3 0.6 0.3 0.5 |
// Melody fragment from the 2nd variation — F#-E-D-C#-B-A-B-C#
:4 4.4 0.1 3.2 1.2 | 0.2 2.3 0.2 1.2 |
// Descending walk against the bass
:4 0.2 2.3 0.3 2.4 | 0.4 4.4 0.3 0.5 |
// Resolve — low D under high D
:4 0.6 0.4 0.6 0.4 | 0.6 r r r |
