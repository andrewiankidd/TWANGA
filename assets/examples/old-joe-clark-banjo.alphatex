\title "Old Joe Clark"
\subtitle "Traditional Appalachian · standard 5-string banjo (Open G)"
\copyright "Traditional public-domain melody (Appalachian, pre-1918). Arrangement under MIT or Apache-2.0."
\tempo 120
\tuning D4 B3 G3 D3 G4
.
