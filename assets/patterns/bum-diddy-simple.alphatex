\title "Bum-diddy (basic)"
\subtitle "Clawhammer banjo, open G drone, 2-bar loop"
\copyright "Pattern under MIT or Apache-2.0."
\tempo 70
\tuning D4 B3 G3 D3 G4
.
// Each "bum-diddy" unit is two beats at 1/8 resolution:
//   bum   = melody note on string 1 (0.1, D4)
//   (rest)= the up-beat of beat 1 — no sound, hand prep
//   di    = brush of strings 1-2-3 ((0.1 0.2 0.3))
//   dy    = thumb on the drone string (0.5, g4)
// Loop with the metronome on to lock in the rhythm.
:8 0.1 r (0.1 0.2 0.3) 0.5 0.1 r (0.1 0.2 0.3) 0.5 |
:8 0.1 r (0.1 0.2 0.3) 0.5 0.1 r (0.1 0.2 0.3) 0.5 |
