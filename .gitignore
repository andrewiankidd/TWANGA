/target/
**/*.rs.bk

# Tauri-generated artifacts (once `cargo tauri init` is run in crates/twanga-app)
/crates/twanga-app/gen/
/crates/twanga-app/target/

# Frontend
/frontend/dist/
/frontend/node_modules/

# Tooling — npm setup for the doc-screenshot capture script. Real
# Playwright dependency lives here so we don't pollute the repo root
# with node_modules just to drive screencaps.
/tools/node_modules/
/tools/package-lock.json
# wasm-bindgen build artifacts — regenerated from twanga-web via
# `cargo build --target wasm32-unknown-unknown -p twanga-web --release`
# followed by `wasm-bindgen --target web --out-dir frontend/web/pkg ...`.
/frontend/web/pkg/
# Bundled alphaTex examples — copied from the canonical
# `assets/examples/` at build time (CI + local Tauri dev). See the
# `pages.yml` workflow + `crates/twanga-app/README.md` dev steps.
/frontend/web/assets/

# User recordings produced by `twanga record`
/recordings/

# Claude Code local settings (machine-specific; settings.json IS committed)
.claude/settings.local.json

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
