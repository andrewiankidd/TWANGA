\title "Twinkle Twinkle Little Star"
\subtitle "for standard ukulele (GCEA, reentrant)"
\copyright "Public domain melody. Arrangement under MIT or Apache-2.0."
\tempo 100
\tuning A4 E4 C4 G4
.
// Bars 1-2: "Twinkle twinkle little star"  C C G G | A A G
:4 0.3 0.3 3.2 3.2 | 0.1 0.1 3.2 r |
// Bars 3-4: "How I wonder what you are"   F F E E | D D C
1.2 1.2 0.2 0.2 | 2.3 2.3 0.3 r |
// Bars 5-6: "Up above the world so high"  G G F F | E E D
3.2 3.2 1.2 1.2 | 0.2 0.2 2.3 r |
// Bars 7-8: "Like a diamond in the sky"   G G F F | E E D
3.2 3.2 1.2 1.2 | 0.2 0.2 2.3 r |
// Bars 9-10: "Twinkle twinkle little star" (repeat)
0.3 0.3 3.2 3.2 | 0.1 0.1 3.2 r |
// Bars 11-12: "How I wonder what you are" (repeat)
1.2 1.2 0.2 0.2 | 2.3 2.3 0.3 r |
